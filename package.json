{
  "name": "recruta.ai---recrutamento-inteligente",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:ci": "eslint src/App.tsx src/services/api.ts src/services/whatsappApi.ts src/hooks src/components/ErrorBoundary.tsx src/pages/recruiter/Billing.tsx src/pages/recruiter/Dashboard.tsx src/pages/recruiter/BulkAnalysis.tsx src/pages/candidate/Dashboard.tsx server/index.ts server/test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "cd server && npm test",
    "test:all": "npm run test && npm run test:server",
    "ops:synthetic": "./ops/monitoring/synthetic-check.sh",
    "ops:security": "./ops/security/check-secrets.sh",
    "ops:prod:check": "./ops/security/check-prod-env.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "server:dev": "cd server && npm run dev",
    "server:install": "cd server && npm install",
    "deploy": "npm run build && NODE_ENV=production node --import tsx server/index.ts",
    "diag": "cd server && npx tsx diag.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@google/genai": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.22.3",
    "shadcn": "^4.2.0",
    "@supabase/supabase-js": "^2.45.6",
    "zod": "^3.23.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.1.4"
  }
}
