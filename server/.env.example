# ==========================================
# Recruta.AI Server — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real keys to git.
# ==========================================

# ── WhatsApp Cloud API (Meta) ──────────────
# Get from: https://developers.facebook.com/apps/ → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-this-to-a-random-secret

# ── Google Gemini AI ───────────────────────
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── AbacatePay (Pagamentos) ─────────────────
# Get from: https://abacatepay.com/dashboard → API Keys
ABACATE_PAY_TOKEN=

# ── Authentication ─────────────────────────
# MUST be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Server ─────────────────────────────────
PORT=3456
FRONTEND_URL=http://localhost:4050

# ── AI Providers (Optional — Fallback chain) ──
# OpenAI (GPT-4o — highest quality, most expensive)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (100+ models — universal fallback)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── CORS (comma-separated origins) ─────────
# Em produção, inclua explicitamente app + site institucional.
# ALLOWED_ORIGINS=https://app.recrutaria.com.br,https://recrutaria.com.br,http://localhost:4050
