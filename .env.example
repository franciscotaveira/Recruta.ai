# === Recruta.AI Environment Variables ===
# Copie este arquivo para .env.local no backend ou apenas .env para execução do Docker

# Porta da API do backend
PORT=3456

# Ambiente (development, production)
NODE_ENV=production

# URLs Base
# DEV only: em produção o frontend usa /api por padrão.
VITE_API_URL=http://localhost:3456/api
# Habilite apenas se api.<dominio> estiver configurado com DNS + SSL válidos.
VITE_ENABLE_API_SUBDOMAIN_FALLBACK=false
# FRONTEND_URL é usado para links absolutos/callbacks no backend.
# DEV: http://localhost:4050 | PROD: https://app.recrutaria.com.br
FRONTEND_URL=http://localhost:4050
# CORS explícito para API cross-origin quando necessário.
ALLOWED_ORIGINS=http://localhost:4050,https://app.recrutaria.com.br,https://recrutaria.com.br

# JWT
JWT_SECRET=super_seguro_mudar_em_prod
JWT_EXPIRES_IN=7d

# Admin bootstrap (opcional, recomendado em produção)
ADMIN_EMAIL=admin@recrutaria.com.br
ADMIN_PASSWORD=trocar_esta_senha_no_primeiro_boot
ADMIN_NAME=Administrador Recrutaria

# WhatsApp Provider
# meta      => WhatsApp Cloud API direto
# automatik => Gateway Automatik/Tomik
WHATSAPP_PROVIDER=meta

# WhatsApp Cloud API (quando WHATSAPP_PROVIDER=meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Gateway (quando WHATSAPP_PROVIDER=automatik)
WHATSAPP_GATEWAY_ENDPOINT=https://edge.automatiklabs.com.br/functions/v1/whatsapp-api
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_WEBHOOK_SECRET=

# Google Gemini (AI)
GEMINI_API_KEY=your_gemini_api_key_here

# AbacatePay (Billing)
ABACATE_PAY_TOKEN=your_abacatepay_live_or_test_key_here
ABACATE_WEBHOOK_SECRET=your_abacatepay_webhook_secret_here
